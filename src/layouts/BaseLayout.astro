import { siteConfig } from "@site.config";
import Navbar from "../components/Navbar.astro";
import SecondNavbar from "../components/SecondNavbar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SecondNavTocButton from "../components/SecondNavTocButton.astro";
import Footer from "../components/Footer.astro";
import SecondNavBreadcrumb from "../components/SecondNavBreadcrumb.astro";
import NavButtonGroup from "../components/NavButtonGroup.astro";
import AlertTemplates from "../components/AlertTemplates.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  coverImg?: string;
  hideTitle?: boolean;
  pageBackground?: "white" | "gray";
  navMode?: "regular" | "short-permanent";
  showBreadcrumbs?: boolean;
  showCurrentPage?: boolean;
  showTableOfContents?: boolean;
  navButtonGroup?: boolean;
  footnotes?: string[];
  customCss?: string[];
  sourcePath?: string;
  frontmatter?: {
    title?: string;
    subtitle?: string;
    description?: string;
    coverImg?: string;
    hideTitle?: boolean;
    pageBackground?: "white" | "gray";
    navMode?: "regular" | "short-permanent";
    showBreadcrumbs?: boolean;
    showTableOfContents?: boolean;
    navButtonGroup?: boolean;
    footnotes?: string[];
    customCss?: string[];
    sourcePath?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || siteConfig.title;
const subtitle =
  frontmatter?.subtitle || Astro.props.subtitle || siteConfig.subtitle || "";
const description =
  frontmatter?.description ||
  Astro.props.description ||
  siteConfig.description ||
  "";
const coverImg = frontmatter?.coverImg || Astro.props.coverImg || "";
const hideTitle = Boolean(frontmatter?.hideTitle ?? Astro.props.hideTitle);
const pageBackground =
  frontmatter?.pageBackground || Astro.props.pageBackground || "white";
const navMode = frontmatter?.navMode || Astro.props.navMode || "regular";
const sourcePath = frontmatter?.sourcePath || Astro.props.sourcePath;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/" || pathname === "/index";
const showBreadcrumbs = Boolean(
  frontmatter?.showBreadcrumbs ?? Astro.props.showBreadcrumbs,
);
const showCurrentPage = Astro.props.showCurrentPage ?? true;
const showTableOfContents = Boolean(
  frontmatter?.showTableOfContents ??
  Astro.props.showTableOfContents ??
  !isHome,
);
const navButtonGroup = Boolean(
  frontmatter?.navButtonGroup ?? Astro.props.navButtonGroup,
);
const footnotes: string[] | undefined =
  frontmatter?.footnotes ?? Astro.props.footnotes;

const pageCustomCss: string[] =
  frontmatter?.customCss || Astro.props.customCss || [];
const allCustomCss = Array.from(
  new Set([...(siteConfig.customCss || []), ...pageCustomCss]),
);

const fullTitle =
  title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const canonicalUrl = siteConfig.url
  ? new URL(Astro.url.pathname, siteConfig.url).toString()
  : undefined;
const { colors } = siteConfig;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      canonicalUrl && (
        <meta property="og:site_name" content={siteConfig.title} />
      )
    }
    {canonicalUrl && <meta property="og:title" content={fullTitle} />}
    {description && <meta name="description" content={description} />}
    <meta name="author" content={siteConfig.author} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <!-- Custom stylesheets from site.config.ts and page frontmatter -->
    {allCustomCss.map((href) => <link rel="stylesheet" href={href} />)}

    <!-- Anti-flicker dark mode script -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }
      })();
    </script>

    <!-- Client-side theme controller -->
    <script>
      import { initThemeToggles } from "../utils/theme";
      initThemeToggles();
      document.addEventListener("astro:page-load", initThemeToggles);
    </script>

    <!-- Client-side TOC controller -->
    <script>
      import { initTOC } from "../utils/toc";
      initTOC();
      document.addEventListener("astro:page-load", initTOC);
    </script>

    <!-- Client-side Alert controller -->
    <script>
      import { initMarkdownAlerts } from "../utils/alert";
      initMarkdownAlerts();
      document.addEventListener("astro:page-load", initMarkdownAlerts);
    </script>

    <!-- Client-side Codeblock controller -->
    <script>
      import { initCodeblocks } from "../utils/codeblock";
      initCodeblocks();
      document.addEventListener("astro:page-load", initCodeblocks);
    </script>

    <!-- Client-side anti-scraper email controller -->
    <script>
      import { initEmailObfuscation } from "../utils/contact";
      initEmailObfuscation();
      document.addEventListener("astro:page-load", initEmailObfuscation);
    </script>

    <!-- Directly inject all colors from root site.config.ts into CSS :root -->
    <style
      is:inline
      set:html={`
      :root:root, :root {
        --page-bg-color: ${colors.pageBgColor};
        --page-bg-color-gray: ${colors.pageBgColorGray};
        --page-bg-color-dark: ${colors.pageBgColorDark};
        --page-bg-color-dark-gray: ${colors.pageBgColorDarkGray};
        --text-color: ${colors.textColor};
        --text-color-dark: ${colors.textColorDark};
        --theme-color: ${colors.themeColor};
        --hover-color: ${colors.hoverColor};
        --link-color: ${colors.linkColor};
        --header-bg-color: ${colors.headerBgColor};
        --header-bg-color-dark: ${colors.headerBgColorDark};
        --navbar-bg-color: ${colors.navbarBgColor};
        --navbar-bg-color-dark: ${colors.navbarBgColorDark};
        --navbar-border-color: ${colors.navbarBorderColor};
        --navbar-text-color: ${colors.navbarTextColor};
        --navbar-float-active-bg-color: ${colors.navbarFloatActiveBgColor};
        --navbar-indicator-gray-light: ${colors.navbarIndicatorGrayLight};
        --navbar-indicator-gray-dark: ${colors.navbarIndicatorGrayDark};
        --footer-bg-color: ${colors.footerBgColor};
        --footer-bg-color-dark: ${colors.footerBgColorDark};
        --footer-text-color: ${colors.footerTextColor};
        --footer-link-color: ${colors.footerLinkColor};
        --footer-hover-color: ${colors.footerHoverColor};
        --page-shadow-color: ${colors.pageShadowColor};
        --btn-normal-bg: ${colors.buttonNormalBg};
        --btn-normal-bg-dark: ${colors.buttonNormalBgDark};
        --btn-normal-text: ${colors.buttonNormalText};
        --btn-normal-text-dark: ${colors.buttonNormalTextDark};
        --btn-theme-bg: ${colors.buttonThemeBg};
        --btn-theme-text: ${colors.buttonThemeText};
        --pill-text: ${colors.pillText};
        --pill-text-dark: ${colors.pillTextDark};
        --second-nav-bg-color: ${colors.secondNavBgColor};
        --second-nav-bg-color-dark: ${colors.secondNavBgColorDark};
      }
    `}
    ></style>
  </head>

  <body class={`page-bg-${pageBackground}`}>
    <Navbar mode={navMode} pageTitle={title} />

    {
      Astro.slots.has("header") ? (
        <slot name="header" />
      ) : (
        !hideTitle && (
          <header
            class:list={["header-section", { "has-img": Boolean(coverImg) }]}
          >
            <div
              class:list={["intro-header", { "big-img": Boolean(coverImg) }]}
              style={
                coverImg ? `background-image: url('${coverImg}');` : undefined
              }
            >
              <div class="container">
                <div class="page-heading">
                  <h1>{title}</h1>
                  {subtitle && <span class="page-subheading">{subtitle}</span>}
                </div>
              </div>
            </div>
          </header>
        )
      )
    }

    <main class="main-page-container">
      <div
        id="main-layout-container"
        class:list={[
          "container",
          "toc-layout-wrapper",
          showTableOfContents ? "toc-expanded" : "toc-collapsed",
        ]}
      >
        {
          showTableOfContents && (
            <aside id="dynamic-toc-container" class="toc-sidebar">
              <TableOfContents />
            </aside>
          )
        }

        <div id="dynamic-main-content" class="toc-content markdown-body">
          {
            (showBreadcrumbs ||
              showTableOfContents ||
              Astro.slots.has("secondNav")) && (
              <SecondNavbar>
                {showTableOfContents && <SecondNavTocButton />}
                {showBreadcrumbs && (
                  <SecondNavBreadcrumb
                    pageTitle={title}
                    showCurrentPage={showCurrentPage}
                  />
                )}
                <slot name="secondNav" />
              </SecondNavbar>
            )
          }
          <slot />
        </div>
      </div>
    </main>

    <Footer pageTitle={title} footnotes={footnotes} sourcePath={sourcePath} />
    <AlertTemplates />
  </body>
</html>
