import { siteConfig } from "@site.config";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import SecondNavbar from "../components/SecondNavbar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SecondNavTocButton from "../components/SecondNavTocButton.astro";
import Footer from "../components/Footer.astro";
import SecondNavBreadcrumb from "../components/SecondNavBreadcrumb.astro";
import NavButtonGroup from "../components/NavButtonGroup.astro";
import AlertTemplates from "../components/AlertTemplates.astro";
import { withBase } from "../utils/url";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  coverImg?: string;
  hideTitle?: boolean;
  pageBackground?: "white" | "gray";
  navMode?: "regular" | "short-permanent";
  showBreadcrumbs?: boolean;
  showBreadcrumbsCurrentPage?: boolean;
  showTableOfContents?: boolean;
  navButtonGroup?: boolean;
  footnotes?: string[];
  customCss?: string[];
  sourcePath?: string;
  file?: string;
  frontmatter?: {
    title?: string;
    subtitle?: string;
    description?: string;
    coverImg?: string;
    hideTitle?: boolean;
    pageBackground?: "white" | "gray";
    navMode?: "regular" | "short-permanent";
    showBreadcrumbs?: boolean;
    showTableOfContents?: boolean;
    navButtonGroup?: boolean;
    footnotes?: string[];
    customCss?: string[];
    sourcePath?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || siteConfig.title;
const subtitle =
  frontmatter?.subtitle || Astro.props.subtitle || siteConfig.subtitle || "";
const description =
  frontmatter?.description ||
  Astro.props.description ||
  siteConfig.description ||
  "";
const coverImg = frontmatter?.coverImg || Astro.props.coverImg || "";
const hideTitle = Boolean(frontmatter?.hideTitle ?? Astro.props.hideTitle);
const pageBackground =
  frontmatter?.pageBackground || Astro.props.pageBackground || "white";
const navMode = frontmatter?.navMode || Astro.props.navMode || "regular";
const sourcePath = frontmatter?.sourcePath || Astro.props.sourcePath;
const file = Astro.props.file || (Astro.props as any).file;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/" || pathname === "/index";
const showBreadcrumbs = Boolean(
  frontmatter?.showBreadcrumbs ?? Astro.props.showBreadcrumbs,
);
const showBreadcrumbsCurrentPage =
  Astro.props.showBreadcrumbsCurrentPage ?? false;
const showTableOfContents = Boolean(
  frontmatter?.showTableOfContents ??
  Astro.props.showTableOfContents ??
  !isHome,
);
const navButtonGroup = Boolean(
  frontmatter?.navButtonGroup ?? Astro.props.navButtonGroup,
);
const footnotes: string[] | undefined =
  frontmatter?.footnotes ?? Astro.props.footnotes;

const pageCustomCss: string[] =
  frontmatter?.customCss || Astro.props.customCss || [];
const allCustomCss = Array.from(
  new Set([...(siteConfig.customCss || []), ...pageCustomCss]),
);

const fullTitle =
  title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const canonicalUrl = siteConfig.url
  ? new URL(Astro.url.pathname, siteConfig.url).toString()
  : undefined;
const { colors } = siteConfig;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      canonicalUrl && (
        <meta property="og:site_name" content={siteConfig.title} />
      )
    }
    {canonicalUrl && <meta property="og:title" content={fullTitle} />}
    {description && <meta name="description" content={description} />}
    <meta name="author" content={siteConfig.author} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{fullTitle}</title>

    <!-- Custom stylesheets from site.config.ts and page frontmatter -->
    {
      allCustomCss.map((href) => (
        <link rel="stylesheet" href={withBase(href)} />
      ))
    }

    <!-- Anti-flicker dark mode script -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }
      })();
    </script>

    <!-- Client-side theme controller -->
    <script>
      import { initThemeToggles } from "../utils/theme";
      initThemeToggles();
      document.addEventListener("astro:page-load", initThemeToggles);
    </script>

    <!-- Client-side TOC controller -->
    <script>
      import { initTOC } from "../utils/toc";
      initTOC();
      document.addEventListener("astro:page-load", initTOC);
    </script>

    <!-- Client-side Alert controller -->
    <script>
      import { initMarkdownAlerts } from "../utils/alert";
      initMarkdownAlerts();
      document.addEventListener("astro:page-load", initMarkdownAlerts);
    </script>

    <!-- Client-side Codeblock controller -->
    <script>
      import { initCodeblocks } from "../utils/codeblock";
      initCodeblocks();
      document.addEventListener("astro:page-load", initCodeblocks);
    </script>

    <!-- Client-side anti-scraper email controller -->
    <script>
      import { initEmailObfuscation } from "../utils/contact";
      initEmailObfuscation();
      document.addEventListener("astro:page-load", initEmailObfuscation);
    </script>

    <!-- Client-side Details/Summary Accordion controller -->
    <script>
      import { initDetailsAnimation } from "../utils/details";
      initDetailsAnimation();
      document.addEventListener("astro:page-load", initDetailsAnimation);
    </script>

    <!-- Client-side Side Navbar Docking controller -->
    <script>
      import { initSideNavbarDocking } from "../utils/side-nav";
      initSideNavbarDocking();
      document.addEventListener("astro:page-load", initSideNavbarDocking);
    </script>

    <!-- Directly inject all colors from root site.config.ts into CSS :root -->
    <style
      is:inline
      set:html={`
      :root:root, :root {
        ${[
          colors.level1BgColor && `--level1-bg-color: ${colors.level1BgColor};`,
          colors.level2BgColor && `--level2-bg-color: ${colors.level2BgColor};`,
          colors.level3BgColor && `--level3-bg-color: ${colors.level3BgColor};`,
          colors.level4BgColor && `--level4-bg-color: ${colors.level4BgColor};`,
          colors.level1BgColorDark && `--level1-bg-color-dark: ${colors.level1BgColorDark};`,
          colors.level2BgColorDark && `--level2-bg-color-dark: ${colors.level2BgColorDark};`,
          colors.level3BgColorDark && `--level3-bg-color-dark: ${colors.level3BgColorDark};`,
          colors.level4BgColorDark && `--level4-bg-color-dark: ${colors.level4BgColorDark};`,

          colors.level1GlassBgColor && `--level1-glass-bg-color: ${colors.level1GlassBgColor};`,
          colors.level2GlassBgColor && `--level2-glass-bg-color: ${colors.level2GlassBgColor};`,
          colors.level1GlassBgColorDark && `--level1-glass-bg-color-dark: ${colors.level1GlassBgColorDark};`,
          colors.level2GlassBgColorDark && `--level2-glass-bg-color-dark: ${colors.level2GlassBgColorDark};`,

          colors.level1TextColor && `--level1-text-color: ${colors.level1TextColor};`,
          colors.level2TextColor && `--level2-text-color: ${colors.level2TextColor};`,
          colors.level3TextColor && `--level3-text-color: ${colors.level3TextColor};`,
          colors.level4TextColor && `--level4-text-color: ${colors.level4TextColor};`,
          colors.level1TextColorDark && `--level1-text-color-dark: ${colors.level1TextColorDark};`,
          colors.level2TextColorDark && `--level2-text-color-dark: ${colors.level2TextColorDark};`,
          colors.level3TextColorDark && `--level3-text-color-dark: ${colors.level3TextColorDark};`,
          colors.level4TextColorDark && `--level4-text-color-dark: ${colors.level4TextColorDark};`,
        ]
          .filter(Boolean)
          .join("\n        ")}

        --theme-color: ${colors.themeColor};
        --navbar-bg-color: ${colors.navbarBgColor};
        --navbar-bg-color-dark: ${colors.navbarBgColorDark};
        --navbar-border-color: ${colors.navbarBorderColor};
        --navbar-text-color: ${colors.navbarTextColor};
      }
    `}
    ></style>
  </head>

  <body class={`page-bg-${pageBackground}`}>
    <Navbar mode={navMode} pageTitle={title} />

    {
      Astro.slots.has("header") ? (
        <slot name="header" />
      ) : (
        !hideTitle && (
          <Hero title={title} subtitle={subtitle} coverImg={coverImg} />
        )
      )
    }

    <main class="main-page-container">
      <nav
        id="side-navbar"
        class="side-nav-container"
        aria-label="Side Navigation"
      >
      </nav>

      <div
        id="main-layout-container"
        class:list={[
          "container",
          "toc-layout-wrapper",
          showTableOfContents ? "toc-expanded" : "toc-collapsed",
        ]}
      >
        {
          showTableOfContents && (
            <aside id="dynamic-toc-container" class="toc-sidebar">
              <TableOfContents />
            </aside>
          )
        }

        <div id="dynamic-main-content" class="toc-content markdown-body">
          {
            (showBreadcrumbs ||
              showTableOfContents ||
              Astro.slots.has("secondNav")) && (
              <SecondNavbar>
                {showTableOfContents && <SecondNavTocButton />}
                {showBreadcrumbs && (
                  <SecondNavBreadcrumb
                    pageTitle={title}
                    showBreadcrumbsCurrentPage={showBreadcrumbsCurrentPage}
                  />
                )}
                <slot name="secondNav" />
              </SecondNavbar>
            )
          }
          <slot />
        </div>
      </div>
    </main>

    <Footer
      pageTitle={title}
      footnotes={footnotes}
      sourcePath={sourcePath}
      file={file}
    />
    <AlertTemplates />
  </body>
</html>
