import BaseLayout from "./BaseLayout.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Button from "../components/Button.astro";
import SecondNavButtonGroup from "../components/SecondNavButtonGroup.astro";
import SecondNavSpacer from "../components/SecondNavSpacer.astro";
import { withBase } from "../utils/url";

interface Props {
  frontmatter?: Record<string, any>;
  [key: string]: any;
}

const { frontmatter = {}, ...restProps } = Astro.props;

const title = frontmatter.title || Astro.props.title || "";
const subtitle = frontmatter.subtitle || Astro.props.subtitle || "";
const author = frontmatter.author || Astro.props.author || "";
const coverImg = frontmatter.coverImg || Astro.props.coverImg || "";
const tags = frontmatter.tags || Astro.props.tags || [];

// 从文件路径或当前 URL 解析文件名与日期
const filePath = Astro.props.file || "";
const fileName = filePath.split("/").pop()?.replace(/\.md$/, "") || "";
const dateFromFileName = fileName.slice(0, 10);
const dateStr = frontmatter.date || dateFromFileName;

// 当前页面完整 URL
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;

// 动态读取同目录下所有文章并排序以计算上一篇与下一篇
const postFiles = import.meta.glob<{
  frontmatter: Record<string, any>;
  url?: string;
}>("/src/pages/posts/*.md", { eager: true });

const allPosts = Object.entries(postFiles)
  .map(([fPath, mod]) => {
    const fName = fPath.split("/").pop()?.replace(/\.md$/, "") || "";
    const dPrefix = fName.slice(0, 10);
    const fm = mod.frontmatter || {};
    const dStr = fm.date || dPrefix;
    return {
      title: fm.subtitle || fm.title || fName,
      url: mod.url || `/posts/${fName}`,
      fileName: fName,
      dateStr: dStr,
      timestamp: new Date(dStr).getTime() || 0,
    };
  })
  .sort((a, b) => b.timestamp - a.timestamp);

const currentIndex = allPosts.findIndex(
  (p) =>
    p.url.replace(/\/$/, "") === currentPath ||
    currentPath.endsWith(p.fileName),
);

const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const prevPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : null;

const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(canonicalUrl);

const platforms = [
  {
    name: "X (Twitter)",
    shareUrl: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"/></svg>',
  },
  {
    name: "Facebook",
    shareUrl: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/></svg>',
  },
  {
    name: "LinkedIn",
    shareUrl: `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>',
  },
  {
    name: "Reddit",
    shareUrl: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M6.167 8a.833.833 0 0 0-.83.83c0 .459.372.84.83.831a.831.831 0 0 0 0-1.661zm4.999 0a.833.833 0 0 0-.83.83c0 .459.372.84.83.831a.831.831 0 0 0 0-1.661z"/><path d="M12.053 6.959c.232-.24.374-.557.374-.906 0-.71-.577-1.286-1.287-1.286-.34 0-.649.133-.88.35L8.4 4.545l.85-2.67 2.37.5a1.19 1.19 0 0 0 1.19 1.19c.657 0 1.19-.533 1.19-1.19 0-.656-.533-1.19-1.19-1.19-.526 0-.97.34-1.127.818L8.98 1.455a.333.333 0 0 0-.317-.233.333.333 0 0 0-.317.233L7.38 4.623 5.74 5.117a1.285 1.285 0 0 0-.88-.35c-.71 0-1.287.576-1.287 1.286 0 .349.142.666.374.906C2.39 7.747 1.5 9.07 1.5 10.583c0 2.21 2.91 4 6.5 4s6.5-1.79 6.5-4c0-1.513-.89-2.836-2.447-3.624zm-3.053 5.375c-.833.833-2.167.833-3 0a.333.333 0 0 1 .471-.471c.573.573 1.485.573 2.058 0a.333.333 0 0 1 .471.471z"/></svg>',
  },
];
---

<BaseLayout
  {...restProps}
  file={filePath}
  frontmatter={frontmatter}
  title={title}
  subtitle={subtitle}
  coverImg={coverImg}
  hideTitle={true}
  showTableOfContents={true}
  showBreadcrumbs={false}
>
  <header
    slot="header"
    class:list={["header-section", { "has-img": Boolean(coverImg) }]}
  >
    <div
      class:list={["intro-header", { "big-img": Boolean(coverImg) }]}
      style={coverImg
        ? `background-image: url('${withBase(coverImg)}');`
        : undefined}
    >
      <div class="container">
        <div class="page-heading">
          <h1>{title}</h1>
          {subtitle && <h2 class="page-subheading">{subtitle}</h2>}
        </div>
      </div>
    </div>
  </header>

  <Fragment slot="secondNav">
    {
      tags.length > 0 && (
        <SecondNavButtonGroup>
          {tags.map((tag: string) => (
            <a
              href={withBase(`/tags#${tag}`)}
              class="second-nav-btn-group-item"
            >
              {tag}
            </a>
          ))}
        </SecondNavButtonGroup>
      )
    }

    <SecondNavSpacer />

    <SecondNavButtonGroup>
      {
        platforms.map((p) => (
          <a
            href={p.shareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="second-nav-btn-group-item nav-btn"
            title={`Share on ${p.name}`}
            aria-label={`Share on ${p.name}`}
          >
            <span set:html={p.icon} />
          </a>
        ))
      }
    </SecondNavButtonGroup>
  </Fragment>

  <slot />

  {
    (author || dateStr) && (
      <p style="margin-top: 2rem;">
        {author && (
          <span>
            By <strong>{author}</strong>
          </span>
        )}
        {author && dateStr && <span> &bull; </span>}
        {dateStr && <span>Posted on {dateStr}</span>}
      </p>
    )
  }

  {
    (prevPost || nextPost) && (
      <div style="margin-top: 2rem; margin-bottom: 2rem;">
        <ButtonGroup>
          {prevPost && (
            <Button
              href={withBase(prevPost.url)}
              variant="normal"
              title={prevPost.title}
            >
              &larr; Previous Post
            </Button>
          )}
          {nextPost && (
            <Button
              href={withBase(nextPost.url)}
              variant="normal"
              title={nextPost.title}
            >
              Next Post &rarr;
            </Button>
          )}
        </ButtonGroup>
      </div>
    )
  }
</BaseLayout>
