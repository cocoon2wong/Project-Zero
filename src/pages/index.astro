import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Pill from "../components/Pill.astro";
import { siteConfig } from "@site.config";
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="container-narrow">
    <h1>{siteConfig.title}</h1>
    <p style="font-size: 1.25rem; opacity: 0.85; margin-bottom: 2rem;">
      {siteConfig.subtitle}
    </p>

    <h2>Section 1: Responsive Design Test</h2>
    <p>
      This is a test paragraph verifying the modern responsive typography and
      container scaling. The typography smoothly adapts across mobile, tablet,
      and desktop viewports using CSS fluid sizing.
    </p>

    <h2>Section 2: Button & Button Group Components</h2>
    <p>
      Unified capsule buttons matching Conghao Wong's signature dual-box-shadow
      visual depth:
    </p>

    <ButtonGroup style="margin-bottom: 1.5rem;">
      <Button variant="normal" href="#demo">Normal Capsule Button</Button>
      <Button variant="theme" href="#demo">Theme Capsule Button</Button>
    </ButtonGroup>

    <h2>Section 3: Segmented Pill Controls</h2>
    <p>
      Segmented pill controls with 55% vertical divider lines and active states:
    </p>

    <div
      style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center; margin-bottom: 1.5rem;"
    >
      <Pill
        items={[
          { label: "All Posts", href: "#", active: true },
          { label: "Tech", href: "#" },
          { label: "Life", href: "#" },
          { label: "About", href: "#" },
        ]}
      />

      <Pill>Single Pill Tag</Pill>
    </div>

    <h2>Section 4: Centralized Color Configuration</h2>
    <p>
      All colors across the entire website are controlled by the single root
      configuration file at <code>site.config.ts</code>. Heading 2 automatically
      receives the configured theme color (<code
        >{siteConfig.colors.themeColor}</code
      >) with Conghao Wong's signature bottom border line in white mode.
    </p>

    <blockquote>
      <p>
        "Separation of concerns: template engine resides in <code>src/</code>,
        while all site content and colors are managed directly in <code
          >site.config.ts</code
        > at the project root."
      </p>
    </blockquote>

    <h2>Section 5: Dark / Light Mode Toggle</h2>
    <p>
      Click the link to toggle mode:
      <a href="#toggle-theme" id="theme-toggle" data-theme-toggle
        >Toggle Dark Mode</a
      >
    </p>
  </div>
</BaseLayout>
