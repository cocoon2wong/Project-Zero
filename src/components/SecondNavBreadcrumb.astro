import SecondNavButtonGroup from "./SecondNavButtonGroup.astro";
import { withBase } from "../utils/url";

interface Props {
  /** Optional override for the current page's terminal breadcrumb label */
  pageTitle?: string;
  /** Whether to show the current page in breadcrumbs. Defaults to false. */
  showBreadcrumbsCurrentPage?: boolean;
  /** Optional custom CSS classes */
  class?: string;
}

const { pageTitle, showBreadcrumbsCurrentPage = false, class: className } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const homePath = withBase("/").replace(/\/$/, "") || "/";
const isHome = pathname === homePath || pathname === withBase("/index");

// 如果配置了 base，从 pathname 中过滤掉 base 前缀后再拆分 segments
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, "");
const relativePathname =
  basePrefix && pathname.startsWith(basePrefix)
    ? pathname.slice(basePrefix.length)
    : pathname;

const segments = relativePathname.split("/").filter(Boolean);
const allCrumbs = segments.map((seg, idx) => {
  const url = withBase("/" + segments.slice(0, idx + 1).join("/") + "/");
  const label = seg.replace(/[-_]/g, " ").replace(/\.html$/, "");
  const capitalized = label.charAt(0).toUpperCase() + label.slice(1);
  return { url, label: capitalized };
});

const crumbs = showBreadcrumbsCurrentPage ? allCrumbs : allCrumbs.slice(0, -1);
---

{
  !isHome && (
    <SecondNavButtonGroup
      as="nav"
      class:list={["breadcrumb-container", className]}
      ariaLabel="breadcrumb"
    >
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href={withBase("/")}>
            <svg
              class="bi bi-house"
              width="1em"
              height="1em"
              viewBox="0 0 18 18"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M2 13.5V7h1v6.5a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V7h1v6.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5zm11-11V6l-2-2V2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5z"
              />
              <path
                fill-rule="evenodd"
                d="M7.293 1.5a1 1 0 0 1 1.414 0l6.647 6.646a.5.5 0 0 1-.708.708L8 2.207 1.354 8.854a.5.5 0 1 1-.708-.708L7.293 1.5z"
              />
            </svg>
            Home
          </a>
        </li>

        {crumbs.map((crumb, idx) => {
          const isOriginalLast = idx === allCrumbs.length - 1;
          const label = isOriginalLast && pageTitle ? pageTitle : crumb.label;
          return (
            <li class="breadcrumb-item">
              <a href={crumb.url}>{label}</a>
            </li>
          );
        })}
      </ol>
    </SecondNavButtonGroup>
  )
}

<style is:global>
/* ==========================================================================
   Secondary Navbar Breadcrumb (Fully Self-contained & Isolated from Footer)
   ========================================================================== */

.second-nav-container .breadcrumb-container {
  padding-right: 0;
}

.second-nav-container .breadcrumb {
  height: 100%;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  list-style: none;
  margin: 0;
  padding: 0;
}

.second-nav-container .breadcrumb-item {
  display: inline-flex;
  align-items: center;
  height: 100%;
  position: relative;
}

.second-nav-container .breadcrumb-item+.breadcrumb-item {
  padding-left: 0;
}

/* Disable default '>' separator in secondary navbar (replaced by 75% vertical line on a::before) */
.second-nav-container .breadcrumb-item+.breadcrumb-item::before {
  display: none;
}

.second-nav-container .breadcrumb-item>a svg {
  vertical-align: middle;
  margin-right: 4px;
}

.second-nav-container .breadcrumb-item>a {
  margin-right: 0;
}

.second-nav-container .breadcrumb-item:last-child>a {
  margin-right: var(--second-navbar-margin);
}

.second-nav-container .breadcrumb-item.active {
  color: var(--second-nav-color);
  padding-right: 4px;
}

.dark-mode .second-nav-container .breadcrumb-item.active {
  color: var(--second-nav-color-dark);
}

/* Secondary Navbar vertical divider line (75% button height) */
.second-nav-container .breadcrumb-item+.breadcrumb-item>a::before {
  content: "";
  position: absolute;
  left: calc(var(--second-navbar-margin) * -0.5);
  top: 50%;
  transform: translate(-50%, -50%);
  width: 1px;
  height: 75%;
  background: var(--second-nav-divider-color);
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.15s ease-in-out;
}

.dark-mode .second-nav-container .breadcrumb-item+.breadcrumb-item>a::before {
  background: var(--second-nav-divider-color-dark);
}

/* Hide adjacent divider lines on hover */
.second-nav-container .breadcrumb-item>a:hover::before {
  opacity: 0;
}

.second-nav-container .breadcrumb-item:has(> a:hover)+.breadcrumb-item>a::before {
  opacity: 0;
}
</style>
