import { siteConfig } from "@site.config";
import { withBase } from "../utils/url";

interface Props {
  pageTitle?: string;
  sourcePath?: string;
  file?: string;
  footnotes?: string[];
}

const { pageTitle, footnotes, sourcePath, file } = Astro.props;

const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const homePath = withBase("/").replace(/\/$/, "") || "/";
const isHome = pathname === homePath || pathname === withBase("/index");
const hideDetailed = Boolean(siteConfig.hideDetailedFooter);
const hasRelatedLinks = Boolean(
  siteConfig.footerRelatedLinks && siteConfig.footerRelatedLinks.length > 0,
);
const homeLabel = hasRelatedLinks ? "Home" : siteConfig.title;

// Parse breadcrumb segments & normalized relative pathname
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, "");
const relativePathname =
  basePrefix && pathname.startsWith(basePrefix)
    ? pathname.slice(basePrefix.length)
    : pathname;
const cleanPath = relativePathname.replace(/^\/|\/$/g, "");

// 编译期自适应获取所有合法页面源文件列表（支持 .astro, .md, .mdx）
const pageModules = import.meta.glob([
  "/src/pages/**/*.astro",
  "/src/pages/**/*.md",
  "/src/pages/**/*.mdx",
]);
const pageKeys = Object.keys(pageModules);

// 自适应匹配物理源文件路径
let matchedSrc = sourcePath || "";

if (!matchedSrc && file) {
  const match = file.match(/\/src\/pages\/(.+)$/);
  if (match) {
    matchedSrc = match[1];
  }
}

if (!matchedSrc) {
  const candidates =
    cleanPath === ""
      ? ["index.astro", "index.mdx", "index.md"]
      : [
          `${cleanPath}/index.astro`,
          `${cleanPath}/index.mdx`,
          `${cleanPath}/index.md`,
          `${cleanPath}.astro`,
          `${cleanPath}.mdx`,
          `${cleanPath}.md`,
        ];

  for (const cand of candidates) {
    if (pageKeys.includes(`/src/pages/${cand}`)) {
      matchedSrc = cand;
      break;
    }
  }
}

// 统一目录映射规则：
// 1. URL 或源文件包含 posts：适配到 __posts 目录（若为列表 index 则在 __pages）
// 2. 其他所有常规页面：适配到 __pages 目录
let resolvedPath = "";
if (matchedSrc) {
  if (cleanPath.includes("posts") || matchedSrc.startsWith("posts/")) {
    const postFile = matchedSrc.replace(/^posts\//, "");
    resolvedPath = postFile.startsWith("index.")
      ? `__pages/${matchedSrc}`
      : `__posts/${postFile}`;
  } else {
    resolvedPath = `__pages/${matchedSrc}`;
  }
} else {
  if (cleanPath.includes("posts")) {
    const slug = cleanPath.split("/").pop();
    resolvedPath =
      slug && slug !== "posts"
        ? `__posts/${slug}.md`
        : "__pages/posts/index.astro";
  } else if (!cleanPath) {
    resolvedPath = "__pages/index.astro";
  } else {
    resolvedPath = `__pages/${cleanPath}.astro`;
  }
}

const showEditButton = Boolean(
  siteConfig.editPageButton && siteConfig.repository && siteConfig.pageBranch,
);
const editUrl =
  showEditButton && resolvedPath
    ? `https://github.com/${siteConfig.repository}/edit/${siteConfig.pageBranch}/${resolvedPath}`
    : "";

const segments = relativePathname.split("/").filter(Boolean);
const crumbs = segments.map((seg, idx) => {
  const url = withBase("/" + segments.slice(0, idx + 1).join("/") + "/");
  const label = seg.replace(/[-_]/g, " ").replace(/\.html$/, "");
  const capitalized = label.charAt(0).toUpperCase() + label.slice(1);
  return { url, label: capitalized };
});
---

<footer class="site-footer">
  <div class="container">
    {
      !hideDetailed && (
        <>
          {/* Footnotes */}
          {footnotes && footnotes.length > 0 && (
            <section class="footer-footnotes" aria-label="Footnotes">
              <ol class="footer-footnotes-list">
                {footnotes.map((note, idx) => (
                  <li>
                    <span class="footnote-number">{idx + 1}.</span>
                    <span class="footnote-text" set:html={note} />
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* Breadcrumb Navigation */}
          <nav
            class="footer-nav breadcrumb-container"
            style="--bs-breadcrumb-divider: '>';"
            aria-label="breadcrumb"
          >
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <a href={withBase("/")}>
                  <svg
                    class="bi bi-house"
                    width="16px"
                    height="16px"
                    viewBox="0 0 18 18"
                    fill="currentColor"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M2 13.5V7h1v6.5a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V7h1v6.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5zm11-11V6l-2-2V2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5z"
                    />
                    <path
                      fill-rule="evenodd"
                      d="M7.293 1.5a1 1 0 0 1 1.414 0l6.647 6.646a.5.5 0 0 1-.708.708L8 2.207 1.354 8.854a.5.5 0 1 1-.708-.708L7.293 1.5z"
                    />
                  </svg>
                  {homeLabel}
                </a>
              </li>

              {!isHome &&
                crumbs.map((crumb, idx) => {
                  const isLast = idx === crumbs.length - 1;
                  return isLast ? (
                    <li class="breadcrumb-item active" aria-current="page">
                      {pageTitle || crumb.label}
                    </li>
                  ) : (
                    <li class="breadcrumb-item">
                      <a href={crumb.url}>{crumb.label}</a>
                    </li>
                  );
                })}
            </ol>
          </nav>

          {/* Site Directory */}
          <section
            class:list={[
              "footer-directory",
              { "is-single-column": !hasRelatedLinks },
            ]}
            aria-label="Site Directory"
          >
            <div class="directory-column">
              {hasRelatedLinks && (
                <div class="directory-list-title">{siteConfig.title}</div>
              )}
              <ul class="directory-list">
                {siteConfig.navLinks.map((link) => {
                  const label =
                    link.footerTitle ||
                    siteConfig.fullNames?.[link.title] ||
                    link.title;
                  return (
                    <li>
                      <a href={withBase(link.url)}>{label}</a>
                    </li>
                  );
                })}
              </ul>
            </div>

            {hasRelatedLinks && (
              <div class="directory-column">
                <div class="directory-list-title">Relevant Links</div>
                <ul class="directory-list">
                  {siteConfig.footerRelatedLinks!.map((link) => (
                    <li>
                      <a
                        href={withBase(link.url)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        </>
      )
    }

    <!-- Copyright & Action Links -->
    <div class="nav-footer-copyright">
      <div class="copyright-text">
        Copyright &copy; {currentYear} {siteConfig.author}. All rights reserved.
      </div>

      <div class="copyright-links">
        <a
          class="footer-toggle-link"
          href="#toggle-theme"
          data-theme-toggle
          title="Toggle dark / light mode"
        >
          Toggle Dark Mode
        </a>
        {
          showEditButton && (
            <a
              title="Edit this page on GitHub"
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Edit page
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
:root {
  --footer-bg-color: var(--level3-bg-color);
  --footer-bg-color-dark: var(--level3-bg-color-dark);
  --footer-text-color: var(--level3-text-color);
  --footer-link-color: var(--level3-text-color);

  --footer-text-active-color: var(--level3-text-color);
  --footer-text-active-color-dark: var(--level3-text-color-dark);
  --footer-footnote-color: var(--level4-text-color);
  --footer-footnote-color-dark: var(--level4-text-color-dark);
  --footer-border-color: var(--level4-bg-color);
  --footer-border-color-dark: var(--level4-bg-color-dark);
}

:global(.dark-mode) {
  --footer-border-color: var(--footer-border-color-dark);
}

/* --- Footer Footnotes --- */

/* Reduce overall footer top padding when footnotes are present */
footer:has(.footer-footnotes) {
  padding-top: 6px !important;
}

.footer-footnotes {
  padding-top: 4px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--footer-border-color);
  margin-bottom: 12px;
  font-size: 11px;
  line-height: 1.33337;
  font-weight: 400;
  letter-spacing: -0.01em;
  color: var(--footer-footnote-color);
  text-align: left;
}

:global(.dark-mode) .footer-footnotes {
  color: var(--footer-footnote-color-dark);
  opacity: 0.8;
}

.footer-footnotes-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-footnotes-list li {
  display: flex;
  align-items: flex-start;
  margin-bottom: 0.5rem;
  font-size: 11px;
  line-height: 1.33337;
  color: inherit;
}

.footer-footnotes-list li:last-child {
  margin-bottom: 0;
}

/* Flexbox hanging indent for numbered footnotes */
.footer-footnotes-list .footnote-number {
  flex-shrink: 0;
  width: 1.4em;
  text-align: left;
  color: inherit;
}

.footer-footnotes-list .footnote-text {
  flex: 1;
}

.footer-footnotes-list a {
  color: inherit;
  text-decoration: underline;
}

.footer-footnotes-list a:hover {
  color: var(--theme-color);
}

/* When footnotes are present, remove top border + padding from the breadcrumb below */
.footer-footnotes+.footer-nav.breadcrumb-container {
  border-top: none !important;
  padding-top: 0;
}

/* --- Footer Outer Container Background & Sizing --- */
footer.site-footer {
  width: 100%;
  padding-top: 5px;
  font-size: 0.875rem;
  background-color: var(--footer-bg-color);
  color: var(--footer-text-active-color);
  border-top: none;
}

:global(.dark-mode) footer.site-footer {
  background-color: var(--footer-bg-color-dark);
  color: var(--footer-text-active-color-dark);
}

/* Gray background page support */
.page-bg-gray footer.site-footer {
  background-color: var(--page-bg-color-gray);
}

:global(.dark-mode) .page-bg-gray footer.site-footer {
  background-color: var(--page-bg-color-dark-gray);
}

/* --- Footer Directory --- */
.footer-directory {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem;
  margin: 0 auto;
  padding-bottom: 10px;
}

.footer-directory.is-single-column {
  grid-template-columns: 1fr;
}

.footer-directory .directory-list-title {
  font-weight: bold;
  margin-bottom: 0.7rem;
}

.directory-column {
  display: flex;
  flex-direction: column;
}

.directory-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-directory.is-single-column .directory-list {
  column-count: 2;
  column-gap: 4rem;
}

.directory-list li {
  margin-bottom: 0.5rem;
}

.directory-list a {
  font-size: 12px;
  text-decoration: none;
  color: var(--footer-text-active-color);
}

:global(.dark-mode) .directory-list a {
  color: var(--footer-text-active-color-dark);
}

.directory-list a:hover {
  color: var(--theme-color);
  text-decoration: underline;
}

@media (max-width: 768px) {
  .footer-directory,
  .footer-directory.is-single-column {
    grid-template-columns: 1fr;
  }

  .footer-directory.is-single-column .directory-list {
    column-count: 1;
  }
}

/* --- Nav Footer Copyright --- */
.nav-footer-copyright {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  padding-top: 15px;
  padding-bottom: 12px;
  border-top: 1px solid var(--footer-border-color);
  font-size: 14px;
  color: var(--footer-text-active-color);
}

:global(.dark-mode) .nav-footer-copyright,
:global(.dark-mode) .copyright-links a {
  color: var(--footer-text-active-color-dark);
}

.copyright-text {
  margin-right: 2rem;
  white-space: nowrap;
}

.copyright-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.copyright-links a {
  text-decoration: none;
  padding: 0 10px;
  border-right: 1px solid var(--footer-border-color);
  line-height: 1;
  color: var(--footer-text-active-color);
  cursor: pointer;
}

.copyright-links a:hover {
  color: var(--theme-color);
  text-decoration: underline;
}

.copyright-links a:first-child {
  padding-left: 0;
}

.copyright-links a:last-child {
  padding-right: 0;
  border-right: none;
}

@media (max-width: 768px) {
  .nav-footer-copyright {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .copyright-links {
    row-gap: 8px;
  }
}
/* ==========================================================================
   Footer Breadcrumb Foundation & Specifics (Scoped strictly to Footer)
   ========================================================================== */

:root {
  --breadcrumb-color: var(--level3-text-color);
  --breadcrumb-color-dark: var(--level3-text-color-dark);
  
  --breadcrumb-hover-color: var(--level1-text-color-dark);
  
  --breadcrumb-active-color: var(--level3-text-color);
  --breadcrumb-active-color-dark: var(--level3-text-color-dark);

  --breadcrumb-background-color: var(--second-nav-bg-color);
  --breadcrumb-background-color-dark: var(--second-nav-bg-color-dark);
}

.footer-nav.breadcrumb-container {
  background: transparent;
  box-shadow: none;
  font-size: 14px;
  padding-left: 0;
  padding-right: 12px;
  margin-bottom: 10px;
  height: auto;
}

body:not(.page-bg-white) .footer-nav.breadcrumb-container {
  border-top: 1px solid var(--footer-border-color);
  padding-top: 10px;
}

body:not(.page-bg-white) .main-page-container {
  padding-bottom: 15px;
}

.footer-nav.breadcrumb-container::before {
  background: transparent;
}

.footer-nav .breadcrumb {
  height: 100%;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
}

.footer-nav .breadcrumb-item {
  display: inline-flex;
  align-items: center;
  height: 100%;
}

.footer-nav .breadcrumb-item+.breadcrumb-item {
  padding-left: 0.5rem;
}

.footer-nav .breadcrumb-item svg {
  vertical-align: middle;
  margin-right: 3px;
}

.footer-nav .breadcrumb .breadcrumb-item:first-child a {
  margin-left: 0;
}

.footer-nav .breadcrumb-item.active {
  color: var(--breadcrumb-active-color);
  padding-right: 4px;
}

:global(.dark-mode) .footer-nav .breadcrumb-item.active {
  color: var(--breadcrumb-active-color-dark);
}

/* 基础分隔符 (默认 > 分隔符，完全保留给 Footer) */
.footer-nav .breadcrumb-item+.breadcrumb-item::before {
  float: left;
  padding-right: 0.5rem;
  color: var(--breadcrumb-color);
  content: var(--bs-breadcrumb-divider, ">");
}

:global(.dark-mode) .footer-nav .breadcrumb-item+.breadcrumb-item::before {
  color: var(--breadcrumb-color-dark);
}

.footer-nav .breadcrumb-item.active::before {
  padding-right: 16px;
}

/* Footer breadcrumb link font color & interactive pill hover */
.footer-nav .breadcrumb-item>a {
  margin: 3px;
  padding: 3px 6px;
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.1s ease-in-out;
  color: var(--breadcrumb-color);
}

:global(.dark-mode) .footer-nav .breadcrumb-item>a {
  color: var(--breadcrumb-color-dark);
}

.footer-nav .breadcrumb-item>a:hover {
  color: var(--breadcrumb-hover-color);
  background-color: var(--theme-color);
}
</style>
