import { siteConfig } from "@site.config";
import { withBase } from "../utils/url";

interface Props {
  pageTitle?: string;
  sourcePath?: string;
  footnotes?: string[];
}

const { pageTitle, footnotes, sourcePath } = Astro.props;

const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const homePath = withBase("/").replace(/\/$/, "") || "/";
const isHome = pathname === homePath || pathname === withBase("/index");
const hideDetailed = Boolean(siteConfig.hideDetailedFooter);
const hasRelatedLinks = Boolean(
  siteConfig.footerRelatedLinks && siteConfig.footerRelatedLinks.length > 0,
);

const resolvedPath =
  sourcePath ||
  (pathname === homePath
    ? "src/pages/index.astro"
    : `src/pages/${pathname.replace(/^\//, "")}.astro`);
const showEditButton = Boolean(
  siteConfig.editPageButton && siteConfig.repository && siteConfig.pageBranch,
);
const editUrl = showEditButton
  ? `https://github.com/${siteConfig.repository}/edit/${siteConfig.pageBranch}/${resolvedPath}`
  : "";

// Parse breadcrumb segments
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, "");
const relativePathname =
  basePrefix && pathname.startsWith(basePrefix)
    ? pathname.slice(basePrefix.length)
    : pathname;

const segments = relativePathname.split("/").filter(Boolean);
const crumbs = segments.map((seg, idx) => {
  const url = withBase("/" + segments.slice(0, idx + 1).join("/") + "/");
  const label = seg.replace(/[-_]/g, " ").replace(/\.html$/, "");
  const capitalized = label.charAt(0).toUpperCase() + label.slice(1);
  return { url, label: capitalized };
});
---

<footer class="site-footer">
  <div class="container">
    {
      !hideDetailed && (
        <>
          {/* Footnotes */}
          {footnotes && footnotes.length > 0 && (
            <section class="footer-footnotes" aria-label="Footnotes">
              <ol class="footer-footnotes-list">
                {footnotes.map((note, idx) => (
                  <li>
                    <span class="footnote-number">{idx + 1}.</span>
                    <span class="footnote-text" set:html={note} />
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* Breadcrumb Navigation */}
          <nav
            class="footer-nav breadcrumb-container"
            style="--bs-breadcrumb-divider: '>';"
            aria-label="breadcrumb"
          >
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <a href={withBase("/")}>
                  <svg
                    class="bi bi-house"
                    width="16px"
                    height="16px"
                    viewBox="0 0 18 18"
                    fill="currentColor"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M2 13.5V7h1v6.5a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V7h1v6.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5zm11-11V6l-2-2V2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5z"
                    />
                    <path
                      fill-rule="evenodd"
                      d="M7.293 1.5a1 1 0 0 1 1.414 0l6.647 6.646a.5.5 0 0 1-.708.708L8 2.207 1.354 8.854a.5.5 0 1 1-.708-.708L7.293 1.5z"
                    />
                  </svg>
                  {siteConfig.title}
                </a>
              </li>

              {!isHome &&
                crumbs.map((crumb, idx) => {
                  const isLast = idx === crumbs.length - 1;
                  return isLast ? (
                    <li class="breadcrumb-item active" aria-current="page">
                      {pageTitle || crumb.label}
                    </li>
                  ) : (
                    <li class="breadcrumb-item">
                      <a href={crumb.url}>{crumb.label}</a>
                    </li>
                  );
                })}
            </ol>
          </nav>

          {/* Site Directory */}
          <section
            class:list={[
              "footer-directory",
              { "is-single-column": !hasRelatedLinks },
            ]}
            aria-label="Site Directory"
          >
            <div class="directory-column">
              {hasRelatedLinks && (
                <div class="directory-list-title">{siteConfig.title}</div>
              )}
              <ul class="directory-list">
                {siteConfig.navLinks.map((link) => {
                  const label =
                    link.footerTitle ||
                    siteConfig.fullNames?.[link.title] ||
                    link.title;
                  return (
                    <li>
                      <a href={withBase(link.url)}>{label}</a>
                    </li>
                  );
                })}
              </ul>
            </div>

            {hasRelatedLinks && (
              <div class="directory-column">
                <div class="directory-list-title">Relevant Links</div>
                <ul class="directory-list">
                  {siteConfig.footerRelatedLinks!.map((link) => (
                    <li>
                      <a
                        href={withBase(link.url)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        </>
      )
    }

    <!-- Copyright & Action Links -->
    <div class="nav-footer-copyright">
      <div class="copyright-text">
        Copyright &copy; {currentYear} {siteConfig.author}. All rights reserved.
      </div>

      <div class="copyright-links">
        <a
          class="footer-toggle-link"
          href="#toggle-theme"
          data-theme-toggle
          title="Toggle dark / light mode"
        >
          Toggle Dark Mode
        </a>
        {
          showEditButton && (
            <a
              title="Edit this page on GitHub"
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Edit page
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>
