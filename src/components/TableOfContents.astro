import LiquidGlass from "./LiquidGlass.astro";

/**
 * Props for the Table of Contents sidebar component.
 */
interface Props {
  /** Edge glow opacity. Defaults to undefined (100% full opacity). */
  edgeOpacity?: number | string;
  /** Optional custom CSS classes */
  class?: string;
}

const { edgeOpacity, class: className } = Astro.props;
---

<LiquidGlass
  hoverable
  as="nav"
  class:list={["table-of-contents-container", className]}
  aria-label="Table of Contents"
  edgeOpacity={edgeOpacity}
>
  <details open id="toc-details-container">
    <summary>
      <a class="toc-title">
        <svg
          class="bi bi-card-list"
          width="1em"
          height="1em"
          viewBox="0 0 18 18"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M14.5 3h-13a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-13z"
          ></path>
          <path
            fill-rule="evenodd"
            d="M5 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 5 8zm0-2.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0 5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5z"
          ></path>
          <circle cx="3.5" cy="5.5" r=".5"></circle>
          <circle cx="3.5" cy="8" r=".5"></circle>
          <circle cx="3.5" cy="10.5" r=".5"></circle>
        </svg>
        &nbsp;Contents
      </a>

      <button
        id="toc-close-btn"
        type="button"
        class="toc-collapse-btn"
        aria-label="Hide Sidebar"
        title="Hide Sidebar"
      >
        <svg
          class="bi bi-layout-sidebar-inset"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M14 2a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM2 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2z"
          ></path>
          <path
            d="M3 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"
          ></path>
        </svg>
      </button>
    </summary>

    <nav id="TABLE_OF_CONTENTS" class="toc-nav-list"></nav>
  </details>
</LiquidGlass>

<style is:global>
:root {
  --toc-bg-color: var(--second-nav-bg-color);
  --toc-bg-color-dark: var(--second-nav-bg-color-dark);

  --toc-title-color: #6c757da0;
  --toc-title-hover-color: #000;
  --toc-title-color-dark: #ffffff;
  --toc-title-hover-color-dark: #fff;

  --toc-text-color: var(--btn-normal-text);
  --toc-text-color-dark: var(--btn-normal-text-dark);

  --toc-hover-bg-color: #eaeaea;

  --toc-theme-color: var(--btn-theme-text);
  --toc-theme-color-dark: var(--btn-theme-text-dark);
  --toc-theme-bg-color: var(--hover-color);

  /* Concentric Radius & Margin Geometry */
  --toc-radius-glass: var(--liquid-glass-radius-inner);
  --toc-radius-outer: var(--liquid-glass-radius-outer);
  --toc-shape-margin: var(--second-navbar-margin);
  --toc-shape-radius: var(--second-navbar-item-radius);
}

/* ==========================================================================
   2. Liquid Glass TOC Outer Container & Content Scroll
   ========================================================================== */

.table-of-contents-container {
  width: 100%;
  transform-origin: top left;
  will-change: width, height, transform, border-radius;
}

/* Layer 3: Content & Embedded Scroll Container */
.table-of-contents-container > details {
  position: relative;
  z-index: 3;
  display: block;
  overflow: auto;
  border-radius: var(--toc-radius-glass);
}

@media (min-width: 992px) {
  .table-of-contents-container > details {
    max-height: calc(100vh - 76px - 15px);
  }
}

/* ==========================================================================
   3. Modern TOC Header & Corner Action Button
   ========================================================================== */

.table-of-contents-container details > summary {
  position: relative;
  display: flex;
  list-style: none;
  cursor: pointer;
  user-select: none;
  outline: none;
}

.table-of-contents-container details > summary::-webkit-details-marker {
  display: none;
}

.toc-title {
  display: flex;
  align-items: center;
  flex-grow: 1;
  padding: 8px 12px 8px 18px;
  font-size: 0.95rem;
  color: var(--toc-title-color) !important;
  letter-spacing: 0.04em;
  text-decoration: none !important;
}

.dark-mode .toc-title {
  color: var(--toc-title-color-dark) !important;
}

.toc-title:hover {
  color: var(--toc-title-hover-color) !important;
}

.dark-mode .toc-title:hover {
  color: var(--toc-title-hover-color-dark) !important;
}

.toc-collapse-btn {
  position: absolute;
  width: 32px;
  height: calc(100% - calc(var(--toc-shape-margin) * 2));
  top: 0;
  right: 0;
  margin: var(--toc-shape-margin);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  border: 0;
  border-radius: var(--toc-shape-radius);
  background-color: transparent;
  color: var(--toc-text-color);
  cursor: pointer;
  transition: all 0.15s ease-in-out;
}

.dark-mode .toc-collapse-btn {
  color: var(--toc-text-color-dark);
}

.dark-mode .toc-collapse-btn:hover {
  color: var(--toc-theme-color-dark);
}

.toc-collapse-btn:hover {
  background-color: var(--toc-theme-bg-color);
  color: var(--toc-theme-color);
  border-radius: var(--toc-shape-radius);
}

/* ==========================================================================
   4. Tree Navigation List
   ========================================================================== */

.toc-nav-list {
  padding: var(--toc-shape-margin);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.toc-link {
  display: block;
  position: relative;
  padding: 6px 12px;
  border-radius: var(--toc-shape-radius);
  font-size: 0.875rem;
  line-height: 1.45;
  color: var(--toc-text-color);
  text-decoration: none !important;
  transition: color 0.15s ease, background-color 0.15s ease;
  word-break: break-word;
}

.dark-mode .toc-link {
  color: var(--toc-text-color-dark);
}

.toc-link.toc-level-2 {
  font-weight: 500;
}

.toc-link.toc-level-3 {
  padding-left: 24px;
  font-size: 0.825rem;
  opacity: 0.9;
}

.toc-link.toc-level-4 {
  padding-left: 36px;
  font-size: 0.8rem;
  opacity: 0.8;
}

.table-of-contents-container .toc-link:hover,
.table-of-contents-container .toc-link.active,
.toc-link:hover,
.toc-link.active {
  color: var(--toc-theme-color) !important;
  background-color: var(--toc-theme-bg-color);
  border-radius: var(--toc-shape-radius);
  text-decoration: none !important;
  opacity: 1;
}

.dark-mode .table-of-contents-container .toc-link:hover,
.dark-mode .table-of-contents-container .toc-link.active,
.dark-mode .toc-link:hover,
.dark-mode .toc-link.active {
  color: var(--toc-theme-color-dark) !important;
}

.toc-link.active {
  font-weight: 600;
}

.toc-link.active::before {
  content: "";
  position: absolute;
  left: 3px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 16px;
  border-radius: 2px;
  background-color: var(--toc-theme-color);
}

@media (max-width: 991.98px) {
  .toc-link {
    min-height: 40px;
    display: flex;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
  }
}
</style>
