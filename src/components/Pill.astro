interface PillItem {
  label: string;
  href?: string;
  active?: boolean;
}

interface Props {
  container?: boolean;
  items?: PillItem[];
  variant?: "normal" | "theme" | "pure";
  class?: string;
  hoverable?: boolean;
}

const {
  container = false,
  items,
  variant = "normal",
  class: className = "",
  hoverable = false,
} = Astro.props;

const variantClass =
  variant === "theme" ? "pill-theme" : variant === "pure" ? "pill-pure" : "";
const hoverableClass = hoverable ? "pill-hoverable" : "";
---

{
  items && items.length > 0 ? (
    <div
      class={`pill pill-container ${variantClass} ${hoverableClass} ${className}`.trim()}
    >
      {items.map((item) =>
        item.href ? (
          <a
            href={item.href}
            class={`pill-item ${item.active ? "is-active" : ""}`.trim()}
          >
            {item.label}
          </a>
        ) : (
          <span class={`pill-item ${item.active ? "is-active" : ""}`.trim()}>
            {item.label}
          </span>
        ),
      )}
    </div>
  ) : container ? (
    <div
      class={`pill pill-container ${variantClass} ${hoverableClass} ${className}`.trim()}
    >
      <slot />
    </div>
  ) : (
    <span class={`pill pill-single ${variantClass} ${className}`.trim()}>
      <slot />
    </span>
  )
}
