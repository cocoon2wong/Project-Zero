interface Props {
  /** Title text */
  title?: string;
  /** Optional custom CSS classes */
  class?: string;
}

const { title, class: className } = Astro.props;
---

<h2 class:list={["second-nav-title", className]}>
  {title ? title : <slot />}
</h2>
