import LiquidGlass from "./LiquidGlass.astro";

/**
 * Props for the Table of Contents restore / expand button.
 */
interface Props {
  /** Edge glow opacity. Defaults to 0.35 to prevent visual dominance. */
  edgeOpacity?: number | string;
  /** Optional custom CSS classes */
  class?: string;
}

const { edgeOpacity = 0.35, class: className } = Astro.props;
---

<LiquidGlass
  class:list={["second-nav-btn-container", className]}
  edgeOpacity={edgeOpacity}
>
  <button
    id="toc-restore-btn"
    type="button"
    class="btn second-nav-btn d-none"
    aria-label="Show Table of Contents"
    title="Show Table of Contents"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      fill="currentColor"
      class="bi bi-layout-sidebar-inset"
      viewBox="0 0 16 16"
      aria-hidden="true"
    >
      <path
        d="M14 2a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM2 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2z"
      ></path>
      <path
        d="M3 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"
      ></path>
    </svg>
  </button>
</LiquidGlass>
