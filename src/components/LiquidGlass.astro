/**
 * Props for the universal LiquidGlass container component.
 */
interface Props {
  /** Underlying HTML tag to render (e.g. 'div', 'nav', 'aside'). Defaults to 'div'. */
  as?: any;
  /** Optional custom CSS classes to append to the wrapper */
  class?: string;
  /** Optional DOM element ID */
  id?: string;
  /**
   * Opacity factor for the 1px gradient edge glow.
   * Can be passed as a float number (e.g. 0.35) or a percentage string (e.g. "35%").
   * When omitted, defaults to 100% full opacity.
   */
  edgeOpacity?: number | string;
  /**
   * Rotation angle for the 1px gradient edge glow (e.g. "135deg", "45deg").
   * When omitted, defaults to 45deg.
   */
  edgeAngle?: string;
  /** Optional inline CSS style string */
  style?: string;
  [key: string]: any;
}

const {
  as: Tag = "div",
  class: className,
  edgeOpacity,
  edgeAngle,
  style,
  ...rest
} = Astro.props;

const opacityVal =
  typeof edgeOpacity === "number"
    ? `${edgeOpacity * 100}%`
    : edgeOpacity !== undefined
      ? `${edgeOpacity}`
      : undefined;

const edgeStyle =
  opacityVal !== undefined ? `--liquid-glass-edge-opacity: ${opacityVal};` : "";

const angleStyle =
  edgeAngle !== undefined ? `--liquid-glass-edge-angle: ${edgeAngle};` : "";

const combinedStyle = [edgeStyle, angleStyle, style].filter(Boolean).join(" ");
---

<Tag
  class:list={["liquidGlass-wrapper", className]}
  style={combinedStyle || undefined}
  {...rest}
>
  <div class="liquidGlass-effect" aria-hidden="true"></div>
  <div class="liquidGlass-tint" aria-hidden="true"></div>
  <div class="liquidGlass-shine" aria-hidden="true"></div>
  <slot />
</Tag>
