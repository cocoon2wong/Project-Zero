import LiquidGlass from "./LiquidGlass.astro";

/**
 * Props for the browser history navigation button group.
 */
interface Props {
  /** Edge glow opacity. Defaults to 0.35. */
  edgeOpacity?: number | string;
  /** Optional custom CSS classes */
  class?: string;
}

const { edgeOpacity = 0.35, class: className } = Astro.props;
---

<LiquidGlass
  class:list={["second-nav-btn-group nav-btn-group", className]}
  aria-label="Browser Navigation"
  edgeOpacity={edgeOpacity}
>
  <button
    id="nav-history-back-btn"
    type="button"
    class="second-nav-btn-group-item nav-btn"
    aria-label="Go Back"
    title="Go Back"
    onclick="window.history.back()"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      fill="currentColor"
      class="bi bi-chevron-left"
      viewBox="0 0 16 16"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"
      ></path>
    </svg>
  </button>

  <button
    id="nav-history-forward-btn"
    type="button"
    class="second-nav-btn-group-item nav-btn"
    aria-label="Go Forward"
    title="Go Forward"
    onclick="window.history.forward()"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      fill="currentColor"
      class="bi bi-chevron-right"
      viewBox="0 0 16 16"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"
      ></path>
    </svg>
  </button>
</LiquidGlass>
