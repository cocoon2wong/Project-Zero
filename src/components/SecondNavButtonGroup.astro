import LiquidGlass from "./LiquidGlass.astro";

interface Props {
  id?: string;
  as?: any;
  class?: string;
  ariaLabel?: string;
  [key: string]: any;
}

const { id, as = "div", class: className, ariaLabel, ...rest } = Astro.props;
---

<LiquidGlass
  hoverable
  id={id}
  as={as}
  class:list={["second-nav-btn-group", className]}
  aria-label={ariaLabel}
  {...rest}
>
  <slot />
</LiquidGlass>
